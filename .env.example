# Variables de Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Pasarela activa: izipay_sdk, izipay o culqi. Vacio = la primera con claves puestas.
PAYMENT_PROVIDER=izipay_sdk

# Variables de Izipay (Back Office Vendedor > Configuracion > Tienda > Claves de API REST)
# Usuario = identificador de la tienda. La contrasena de test empieza con
# "testpassword_" y pone a Izipay en modo TEST; la de produccion, "prodpassword_".
IZIPAY_USERNAME=your_izipay_shop_id
IZIPAY_PASSWORD=your_izipay_rest_password
IZIPAY_PUBLIC_KEY=your_izipay_public_key
IZIPAY_HMAC_KEY=your_izipay_hmac_sha256_key
# IZIPAY_API_URL=https://api.micuentaweb.pe
# IZIPAY_MIN_ORDER_CENTIMOS=100

# SDK de Izipay (tarjeta, Yape, Plin, QR). Claves del panel de comercio:
# sandbox-panel.izipay.pe (pruebas) o panel.izipay.pe > Desarrolladores > Claves.
IZIPAY_SDK_MERCHANT_CODE=your_merchant_code
IZIPAY_SDK_API_KEY=your_payment_button_api_key
IZIPAY_SDK_HASH_KEY=your_hash_key
IZIPAY_SDK_RSA_PUBLIC_KEY=your_izipay_rsa_public_key
IZIPAY_SDK_ENV=sandbox
IZIPAY_SDK_IPN_URL=https://your-backend.example.com/api/webhooks/izipay-sdk
IZIPAY_SDK_RUC=your_company_ruc
# IZIPAY_SDK_PAY_METHODS=CARD,YAPE_CODE,PAGO_PUSH,QR

# Variables de Culqi (respaldo)
CULQI_PUBLIC_KEY=your_culqi_public_key
CULQI_PRIVATE_KEY=your_culqi_private_key

# Configuración de la API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# URL de tu página web (para CORS)
FRONTEND_URL=http://localhost:3000
